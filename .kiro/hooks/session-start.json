{
  "version": "v1",
  "hooks": [
    {
      "name": "tiket-session-start-sessionstart",
      "trigger": "SessionStart",
      "action": {
        "type": "command",
        "command": "python3 scripts/session_start.py || python scripts/session_start.py"
      },
      "timeout": 120
    },
    {
      "name": "tiket-session-start-agentspawn",
      "trigger": "AgentSpawn",
      "action": {
        "type": "command",
        "command": "python3 scripts/session_start.py || python scripts/session_start.py"
      },
      "timeout": 120
    }
  ]
}
